# =====================================================================
#  ABA Payway (KHQRPay) credentials
#  Copy this file to ".env" and fill in your real values.
#  Values loaded from .env OVERRIDE whatever is saved in the POS UI, and
#  any key set here becomes READ ONLY in the POS Settings page (so the
#  credentials cannot be changed by whoever is standing at the till).
#  config.py contains no secrets - this file is the only place they live
#  outside the database. Never commit it (.gitignore already blocks it).
# =====================================================================

# Your ABA Payway merchant / profile id
ABA_PROFILE_ID=

# Your Payment Secret (used to build every sha1/sha256 signature)
ABA_SECRET_KEY=

# Gateway base url (no trailing slash)
ABA_API_BASE=https://anajakpay.com

# Frontend POS url - ABA redirects the customer back here
FRONTEND_BASE_URL=http://localhost:3000

# Where ABA sends the customer after a successful payment
ABA_SUCCESS_URL=http://localhost:3000/?payment=success
ABA_CANCEL_URL=http://localhost:3000/?payment=cancel

# "true" = POS can mark a KHQR order as paid manually when the gateway
#   is unreachable / not configured yet (handy for local testing).
ABA_DEMO_MODE=true

# =====================================================================
#  App
# =====================================================================
# Allowed browser origins (comma separated). "http://<private-ip>:3000" is
# already allowed by POS_CORS_ORIGIN_REGEX, so leave this alone unless the POS
# is served from a public domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the SQLite file lives. Empty = pos.db next to this file (plenty when the
# API runs on the till itself). On a host with an ephemeral filesystem, point it
# at a mounted persistent disk - note the FOUR slashes (three are the scheme):
#   DATABASE_URL=sqlite:////var/data/pos.db
DATABASE_URL=

# =====================================================================
#  Security (see security.py + manage.py)
# =====================================================================
# Password given to the first administrator. Leave empty and the API will
# generate a strong one, print it once in the log and write it to
# backend_api/initial_admin_password.txt (delete that file after signing in).
POS_ADMIN_USERNAME=admin
POS_ADMIN_PASSWORD=

# How long a sign-in lasts (hours) before the POS asks for the password again.
POS_TOKEN_TTL_HOURS=12

# Brute force / flood protection.
POS_LOGIN_MAX_ATTEMPTS=6
POS_LOGIN_WINDOW_SECONDS=300
POS_REQUEST_RATE_PER_MINUTE=600
POS_WRITE_RATE_PER_MINUTE=240

# Largest JSON body accepted, in MB (backup import needs some room).
POS_MAX_BODY_MB=25

# Minimum password length for POS accounts.
POS_MIN_PASSWORD_LENGTH=8

# Host header allow-list. "*" (default) accepts any Host header; set your
# address(es) once you know them, e.g. POS_ALLOWED_HOSTS=127.0.0.1,192.168.1.5
POS_ALLOWED_HOSTS=*

# Extra browser origins allowed to call the API (regex). Empty disables it.
# POS_CORS_ORIGIN_REGEX=^https?://pos\.myshop\.kh$

# Interactive docs (/docs, /openapi.json) are OFF by default because they hand
# an attacker a map of every endpoint. Turn them on only while developing.
POS_ENABLE_DOCS=false

# DANGER: true disables authentication completely. Local debugging only -
# never leave this on a machine the shop (or the internet) can reach.
POS_AUTH_DISABLED=false
